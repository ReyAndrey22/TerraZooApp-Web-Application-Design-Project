@model TerraZooApp.Models.Animal

@{
    ViewData["Title"] = "Add Animal";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Add new animal</h2>

<form asp-action="AddAnimal" enctype="multipart/form-data">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="NameAnimal"></label>
                <input asp-for="NameAnimal" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Species"></label>
                <input asp-for="Species" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="ScientificName"></label>
                <input asp-for="ScientificName" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Breed"></label>
                <input asp-for="Breed" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Sex"></label>
                <select asp-for="Sex" class="form-control">
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                </select>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="Age"></label>
                <input asp-for="Age" class="form-control" type="number" />
            </div>
            <div class="form-group">
                <label asp-for="NaturalHabitat"></label>
                <input asp-for="NaturalHabitat" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="DietType"></label>
                <input asp-for="DietType" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="ImageAnimalFile">Upload image</label>
                <input asp-for="ImageAnimalFile" class="form-control" type="file" accept="image/*" />
            </div>
        </div>
    </div>
    <br />
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="IndexAnimal" class="btn btn-secondary">Cancel</a>
</form>
