@model IEnumerable<TerraZooApp.Models.Animal>

@{
    ViewData["Title"] = "Animals";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2>Animals</h2>
            <a asp-action="AddAnimal" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Animal
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <form asp-action="IndexAnimal" method="get" class="d-flex">
                <div class="input-group">
                    <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Search by name..." />
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Search
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter))
                    {
                        <a asp-action="IndexAnimal" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Reset
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Species</th>
                            <th>Scientific Name</th>
                            <th>Breed</th>
                            <th>Sex</th>
                            <th>Age</th>
                            <th>Natural Habitat</th>
                            <th>Diet Type</th>
                            <th>Image</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var animal in Model)
                        {
                            <tr>
                                <td>@animal.IdAnimal</td>
                                <td>@animal.NameAnimal</td>
                                <td>@animal.Species</td>
                                <td>@animal.ScientificName</td>
                                <td>@animal.Breed</td>
                                <td>@animal.Sex</td>
                                <td>@animal.Age</td>
                                <td>@animal.NaturalHabitat</td>
                                <td>@animal.DietType</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(animal.ImageAnimal))
                                    {
                                        <img src="~/images/animals/@animal.ImageAnimal" width="150" height="150" class="img-thumbnail" style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No image</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="UpdateAnimal" asp-route-id="@animal.IdAnimal" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="DeleteAnimal" asp-route-id="@animal.IdAnimal" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
