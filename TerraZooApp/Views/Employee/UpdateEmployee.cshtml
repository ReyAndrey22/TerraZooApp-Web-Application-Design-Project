@model TerraZooApp.Models.Employee

@{
    ViewData["Title"] = "Edit Employee";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Edit Employee</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="IdEmployee" />

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" type="email" />
            </div>
            <div class="form-group">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Address"></label>
                <input asp-for="Address" class="form-control" />
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="HireDate"></label>
                <input asp-for="HireDate" class="form-control" type="date" />
            </div>
            <div class="form-group">
                <label asp-for="Salary"></label>
                <input asp-for="Salary" class="form-control" type="number" step="10" />
            </div>
            <div class="form-group">
                <label asp-for="Position"></label>
                <input asp-for="Position" class="form-control" />
            </div>
        </div>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="IndexEmployee" class="btn btn-secondary">Back</a>
</form>
