@{
    Layout = "_VisitorLayout";
}
@model IEnumerable<TerraZooApp.Models.Review>
@{
    ViewData["Title"] = "Animal Reviews";
    var animal = ViewBag.Animal as TerraZooApp.Models.Animal;
}
<div class="container mt-4">
    <h2>Reviews for @animal?.NameAnimal</h2>
    <a asp-action="Add" asp-route-animalId="@animal?.IdAnimal" class="btn btn-primary mb-3">Add Review</a>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (!Model.Any())
    {
        <div class="alert alert-info">No reviews yet for this animal.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var review in Model)
            {
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Rating: @review.Rating/5</h5>
                            <p class="card-text">@review.Comment</p>
                            <p class="card-text"><small class="text-muted">@review.DateReview.ToString("dd/MM/yyyy")</small></p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    <a href="@Url.Action("ListAnimals", "Animal")" class="btn btn-secondary mt-3">Back to Animals</a>
</div> 