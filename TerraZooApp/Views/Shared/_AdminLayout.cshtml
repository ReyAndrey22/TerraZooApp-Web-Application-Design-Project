@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        body {
            display: flex;
            min-height: 100vh;
            margin: 0;
            background-color: #f8f9fa;
        }

        .sidebar {
            width: 240px;
            background-color: #343a40;
            color: white;
            padding-top: 20px;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            z-index: 1000;
        }

        .sidebar a {
            color: white;
            text-decoration: none;
            display: block;
            padding: 12px 20px;
            transition: all 0.3s ease;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background-color: #495057;
            padding-left: 25px;
        }

        .sidebar i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
        }

        .main-content {
            flex-grow: 1;
            margin-left: 240px;
            padding: 20px;
            min-height: 100vh;
            background-color: #f8f9fa;
        }

        .logout-btn {
            margin-top: auto;
            padding: 20px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .page-header {
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid #dee2e6;
        }

        .card {
            transition: transform 0.2s ease;
        }

        .card:hover {
            transform: translateY(-5px);
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h4 class="text-center mb-4">Admin Panel</h4>
        <hr class="mx-3" />
        <a href="@Url.Action("DashboardAdmin", "Admin")">
            <i class="fas fa-tachometer-alt"></i>Dashboard
        </a>
        <a href="@Url.Action("ViewProfileAdmin", "Admin")">
            <i class="fas fa-user"></i>Profile
        </a>
        <a href="@Url.Action("IndexAnimal", "Animal")">
            <i class="fas fa-paw"></i>Animals
        </a>
        <a href="@Url.Action("IndexEmployee", "Employee")">
            <i class="fas fa-users"></i>Employees
        </a>
        <a href="@Url.Action("Index","UserManagement")">
            <i class="fas fa-user-friends"></i>Users
        </a>
        <a href="@Url.Action("IndexTerraZooSchedule", "TerraZooSchedule")">
            <i class="fas fa-calendar-alt"></i>Zoo Schedule
        </a>
		<a href="@Url.Action("Index", "TicketType")">
			<i class="fas fa-ticket-alt"></i>Ticket Types
		</a>
        <div class="logout-btn">
            <a href="/UsersAuth/Logout" class="btn btn-danger w-100">
                <i class="fas fa-sign-out-alt"></i>Logout
            </a>
        </div>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
