@model IEnumerable<TerraZooApp.Models.TerraZooSchedule>

@{
    ViewData["Title"] = "TerraZoo Schedule";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2>TerraZoo Schedule</h2>
            <a asp-action="AddTerraZooSchedule" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Schedule
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Day of Week</th>
                            <th>Opening Time</th>
                            <th>Closing Time</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in Model)
                        {
                            <tr>
                                <td>@schedule.IdTerraZooSchedule</td>
                                <td>@schedule.DayOfWeek</td>
                                <td>@schedule.OpeningHour.ToString("HH:mm")</td>
                                <td>@schedule.ClosingHour.ToString("HH:mm")</td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="UpdateTerraZooSchedule" asp-route-id="@schedule.IdTerraZooSchedule" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
