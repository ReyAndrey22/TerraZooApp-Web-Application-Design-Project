@model IEnumerable<TerraZooApp.Models.Users>

@{
    ViewData["Title"] = "Gestionare Utilizatori";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2>View Users</h2>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex">
                <div class="input-group">
                    <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Search by name, email or role..." />
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Search
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter))
                    {
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Reset
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Profile Picture</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Lastname</th>
                            <th>Firstname</th>
                            <th>Role</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.ProfilePicture))
                                    {
                                        <img src="~/images/profile_picture/@user.ProfilePicture" alt="Profile Picture" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-user-circle fa-2x text-secondary"></i>
                                    }
                                </td>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>@user.LastName</td>
                                <td>@user.FirstName</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.Role))
                                    {
                                        <span class="badge @(user.Role.ToLower() == "admin" ? "bg-danger" : 
                                                          user.Role.ToLower() == "tour guide" ? "bg-success" : 
                                                          "bg-primary")">
                                            @user.Role
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.Role?.ToLower() == "tour guide")
                                    {
                                        <a asp-controller="TourGuideSchedule" asp-action="Index" asp-route-userId="@user.Id" class="btn btn-info btn-sm">
                                            <i class="fas fa-calendar-alt"></i> Program
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div> 