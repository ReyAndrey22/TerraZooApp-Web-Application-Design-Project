@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_VisitorLayout.cshtml";
}

<div class="container py-5">
    <div class="row mb-5">
        <div class="col-lg-8 mx-auto text-center">
            <h1 class="display-4 mb-4">Our Story</h1>
            <p class="lead text-muted">From a simple dream to an unforgettable destination</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-6">
            <img src="~/images/images_visitor/poza-zoo.jpg" class="img-fluid rounded shadow" alt="TerraZoo History">
        </div>
        <div class="col-md-6">
            <h2 class="mb-4">The Beginning</h2>
            <p class="mb-4">TerraZoo opened its doors in 2005, starting from a simple vision: creating a space where people and animals can coexist in harmony, and education is accessible to everyone.</p>
            <p class="mb-4">In its early years, the zoo started with just 50 animals and 5 dedicated employees. Today, we are proud to host over 500 animals from 100 different species and have a team of over 100 passionate professionals.</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-12">
            <div class="card bg-light border-0 shadow-sm">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4">Our Mission</h2>
                    <div class="row">
                        <div class="col-md-4 text-center mb-4">
                            <i class="fas fa-heart fa-3x text-success mb-3"></i>
                            <h4>Conservation</h4>
                            <p>We protect endangered species and promote biodiversity</p>
                        </div>
                        <div class="col-md-4 text-center mb-4">
                            <i class="fas fa-graduation-cap fa-3x text-success mb-3"></i>
                            <h4>Education</h4>
                            <p>We educate and inspire future generations to care for nature</p>
                        </div>
                        <div class="col-md-4 text-center mb-4">
                            <i class="fas fa-hands-helping fa-3x text-success mb-3"></i>
                            <h4>Research</h4>
                            <p>We contribute to the study and protection of wildlife</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-8 mx-auto">
            <h2 class="text-center mb-4">Important Achievements</h2>
            <div class="timeline">
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">2010</h5>
                        <p class="card-text">Launch of the breeding program for endangered species</p>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">2015</h5>
                        <p class="card-text">Opening of the children's education center</p>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">2020</h5>
                        <p class="card-text">Certification as a zoo of excellence in Europe</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>