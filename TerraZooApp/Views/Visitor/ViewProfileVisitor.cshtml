@model TerraZooApp.Models.Users
@using System.Linq
@{
    ViewData["Title"] = "My Profile";
    Layout = "_VisitorLayout";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                    {
                        <img src="~/images/profile_picture/@Model.ProfilePicture" class="rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;" alt="Profile Picture" />
                    }
                    else
                    {
                        <img src="~/images/profile_picture/default.jpg" class="rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;" alt="Default Profile Picture" />
                    }
                    <h4>@Model.FirstName @Model.LastName</h4>
                    <p class="text-muted">@Model.Role</p>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4>Profile Information</h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success">@ViewBag.Success</div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <div asp-validation-summary="All" class="text-danger"></div>
                        </div>
                    }

                    <form asp-controller="UsersAuth" asp-action="ViewProfile" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Role" value="visitor" readonly />
                        
                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">Username</label>
                            <input asp-for="UserName" class="form-control" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label">First Name</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProfilePicture" class="form-label">Profile Picture</label>
                            <input type="file" name="ProfilePictureFile" class="form-control" accept="image/*" />
                        </div>

                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </form>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">My Tickets</h4>
                    <a asp-controller="VisitorTicket" asp-action="BuyTickets" class="btn btn-primary btn-sm">Buy New Tickets</a>
                </div>
                <div class="card-body">
                    @if (ViewBag.Tickets == null || ((List<TerraZooApp.Models.Ticket>)ViewBag.Tickets).Count == 0)
                    {
                        <div class="alert alert-info">
                            You don't have any tickets yet. <a asp-controller="VisitorTicket" asp-action="BuyTickets" class="alert-link">Buy tickets</a>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var ticket in ViewBag.Tickets)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100">
                                        <div class="card-header">
                                            <h5 class="mb-0">
                                                @if (ticket.Tour != null)
                                                {
                                                    @ticket.Tour.Title
                                                }
                                                else
                                                {
                                                    <span>Ticket not reserved for a tour</span>
                                                }
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <p><strong>Ticket Type:</strong> @ticket.TicketType?.NameTicketType</p>
                                            <p><strong>Price:</strong> @ticket.TicketType?.Price RON</p>
                                            @if (ticket.Tour != null)
                                            {
                                                <p><strong>Tour Date:</strong> @ticket.Tour.DateTour.ToString("dd/MM/yyyy")</p>
                                                <p><strong>Tour Time:</strong> @ticket.Tour.StartHour.ToString("HH:mm")</p>
                                            }
                                            <p><strong>Purchase Date:</strong> @ticket.PurchaseDate.ToString("dd/MM/yyyy")</p>

                                            @if (ticket.IdTour == null)
                                            {
                                                <button type="button" class="btn btn-success mt-2 reserve-tour-btn" data-bs-toggle="modal" data-bs-target="#reserveTourModal" data-ticket-id="@ticket.IdTicket">
                                                    Reserve Tour
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reserve Tour Modal -->
<div class="modal fade" id="reserveTourModal" tabindex="-1" aria-labelledby="reserveTourModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reserveTourModalLabel">Reserve a Tour</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="VisitorTicket" asp-action="ReserveTour" method="post">
                <div class="modal-body">
                    <input type="hidden" id="ticketIdInput" name="ticketId" value="" />
                    <div class="form-group">
                        <label for="tourId">Select a Tour:</label>
                        <select name="tourId" id="tourId" class="form-control" required>
                            <option value="">Choose an available tour</option>
                            @foreach (var tour in ViewBag.AvailableTours)
                            {
                                <option value="@tour.IdTour">
                                    @tour.Title - @tour.DateTour.ToString("dd/MM/yyyy") @tour.StartHour.ToString("HH:mm") (@tour.NumberOfSpots spots left)
                                </option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Reserve Tour</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var reserveTourModal = document.getElementById('reserveTourModal');
            reserveTourModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var ticketId = button.getAttribute('data-ticket-id');
                var modalTicketIdInput = reserveTourModal.querySelector('#ticketIdInput');
                modalTicketIdInput.value = ticketId;
            });
        });
    </script>
} 