@model IEnumerable<TerraZooApp.Models.TerraZooSchedule>

@{
    ViewData["Title"] = "TerraZoo Schedule";
    Layout = "~/Views/Shared/_VisitorLayout.cshtml";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-center mb-4">TerraZoo Schedule</h2>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-success">
                                <tr>
                                    <th>Day of Week</th>
                                    <th>Opening Time</th>
                                    <th>Closing Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var schedule in Model)
                                {
                                    <tr>
                                        <td>@schedule.DayOfWeek</td>
                                        <td>@schedule.OpeningHour.ToString("HH:mm")</td>
                                        <td>@schedule.ClosingHour.ToString("HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

