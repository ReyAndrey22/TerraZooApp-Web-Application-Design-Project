@{
    ViewData["Title"] = "Buy Tickets";
    Layout = "_VisitorLayout";
}

<div class="container mt-4">
    <h2 class="mb-4">Buy Tickets</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h4>Available Ticket Types</h4>
                </div>
                <div class="card-body">
                    <form asp-action="PurchaseTicket" method="post">
                        <div class="form-group mb-3">
                            <label for="ticketTypeId">Select ticket type:</label>
                            <select name="ticketTypeId" class="form-control" required>
                                <option value="">Choose a ticket type</option>
                                @foreach (var ticketType in ViewBag.TicketTypes)
                                {
                                    <option value="@ticketType.IdTicketType">
                                        @ticketType.NameTicketType - @ticketType.Price RON
                                    </option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary mt-2">Buy Ticket</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4><i class="fas fa-map-signs me-2"></i>Available Tours</h4>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var tour in ViewBag.AvailableTours)
                        {
                            <div class="col-12">
                                <div class="card shadow-sm border-0 mb-2" style="background: #f8fafc;">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h5 class="card-title mb-0 text-primary">
                                                <i class="fas fa-binoculars me-2"></i>@tour.Title
                                            </h5>
                                            <span class="badge bg-success"><i class="fas fa-users"></i> @tour.NumberOfSpots spots</span>
                                        </div>
                                        <div class="mb-2">
                                            <span class="badge bg-secondary"><i class="fas fa-calendar-alt"></i> @tour.DateTour.ToString("dd/MM/yyyy")</span>
                                            <span class="badge bg-warning text-dark ms-2"><i class="fas fa-clock"></i> @tour.StartHour.ToString("HH:mm") - @tour.EndHour.ToString("HH:mm")</span>
                                            <span class="badge bg-info text-dark ms-2"><i class="fas fa-hourglass-half"></i> @tour.Duration min</span>
                                        </div>
                                        <p class="card-text mb-1"><i class="fas fa-align-left me-2"></i>@tour.Description</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 